# Tortoise configuration — copy to .env and fill in.
# Everything here is a secret or an environment-specific setting; never commit .env.

# --- Browserbase (real runs; free plan = 1 browser hour/month) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Ultramarine 1 Flash (Paper Instruments) — writes the weekly brief ---
# Claim the $5 Hacktoberfest credit, then create an API key.
ULTRAMARINE_API_KEY=
ULTRAMARINE_BASE_URL=https://api.paperinstruments.com/v1
ULTRAMARINE_MODEL=ultramarine-1-flash

# --- Ollama (local, free) — filters every application ---
OLLAMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma4:e4b

# --- The model that drives Stagehand's act/extract calls ---
# Default: local Ollama (free). As soon as ULTRAMARINE_API_KEY above is set,
# the driving model automatically switches to ultramarine-1-flash — recommended,
# because a local 4B model cannot reliably click through council portals
# (~1-3 cents per weekly crawl). Set STAGEHAND_* to override explicitly.
# STAGEHAND_BASE_URL=
# STAGEHAND_API_KEY=
# STAGEHAND_MODEL=

# --- Browserbase session region ---
# UK council portals block non-EU traffic; eu-central-1 is the default.
# BROWSERBASE_REGION=eu-central-1

# --- Brevo (email delivery, free plan) ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Tortoise
TORTOISE_TO_EMAIL=

# --- Paths ---
TORTOISE_DATA_DIR=data
# Save a screenshot of every page a run opens (evidence and demo footage):
# TORTOISE_CAPTURE_DIR=data/capture
# The logo in the email header; must be a public URL (mail clients block embedded images):
# TORTOISE_LOGO_URL=https://raw.githubusercontent.com/<user>/tortoise/main/assets/logo-email.png

# --- Failure-test flags (leave unset in real runs) ---
# Tortoise makes Ultramarine fail every call (failure test 3):
# TORTOISE_TEST_BRIEF_FAIL=1
# Tortoise stalls the crawl's first attempt past its 2-minute heartbeat
# timeout, before a browser opens; the retry runs normally (failure test 6):
# TORTOISE_TEST_CRAWL_DELAY_MS=150000
# Tortoise points Gemma at a dead port (failure test 4):
# TORTOISE_TEST_OLLAMA_DOWN=1
