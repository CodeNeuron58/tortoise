# Tortoise configuration — copy to .env and fill in.
# Everything here is a secret or an environment-specific setting; never commit .env.

# --- Browserbase (real runs; free plan = 1 browser hour/month) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# --- Ultramarine 1 Flash (Paper Instruments) — writes the weekly brief ---
# Claim the $5 Hacktoberfest credit, then create an API key.
ULTRAMARINE_API_KEY=
ULTRAMARINE_BASE_URL=https://api.paperinstruments.com/v1
ULTRAMARINE_MODEL=ultramarine-1-flash

# --- Ollama (local, free) — filters every application ---
OLLAMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma4:e4b

# --- The model that drives Stagehand's act/extract calls ---
# Defaults to local Ollama so the crawl costs nothing. Can be pointed at any
# OpenAI-compatible endpoint.
STAGEHAND_BASE_URL=http://localhost:11434/v1
STAGEHAND_API_KEY=ollama
STAGEHAND_MODEL=gemma4:e4b

# --- Brevo (email delivery, free plan) ---
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Tortoise
TORTOISE_TO_EMAIL=

# --- Paths ---
TORTOISE_DATA_DIR=data

# --- Failure-test flags (leave unset in real runs) ---
# Tortoise makes Ultramarine fail every call (failure test 3):
# TORTOISE_TEST_BRIEF_FAIL=1
# Tortoise adds an artificial delay before every crawl request (failure test 6):
# TORTOISE_TEST_CRAWL_DELAY_MS=20000
# Tortoise points Gemma at a dead port (failure test 4):
# TORTOISE_TEST_OLLAMA_DOWN=1
